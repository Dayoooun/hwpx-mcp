    "claude",
    "codex",
    "llm",
    "ai"
  ],
  "author": "Dayoun Kim <dayoooun@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Dayoooun/hwpx-mcp#readme",
  "repository": {
